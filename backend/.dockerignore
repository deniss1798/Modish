# Dockerfile uses this directory as its build context and COPY . . as payload.
# Keep app/, alembic/, scripts/, requirements.txt and source test fixtures.

# Local configuration and private signing/provider credentials.
**/.env*
**/*.env
**/.ssh
**/.aws
**/.azure
**/.config/gcloud
**/.pgpass
**/.netrc
**/.pypirc
**/.npmrc
**/.git-credentials
**/id_rsa
**/id_dsa
**/id_ecdsa
**/id_ed25519
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/*.jks
**/*.keystore
**/key.properties
**/credentials
**/credentials.json
**/service-account*.json
**/service_account*.json
**/secrets
**/.secrets
**/secrets.*

# Dependencies and local Python/tool state; dependencies install from requirements.
**/.venv
**/venv
**/env
**/node_modules
**/.tox
**/.nox
**/__pycache__
**/*.py[cod]
**/*.egg-info
**/.pytest_cache
**/.mypy_cache
**/.ruff_cache
**/.hypothesis
**/.coverage*
**/htmlcov
**/coverage
**/.gradle
**/.dart_tool

# VCS and editor metadata.
**/.git
**/.hg
**/.svn
**/.idea
**/.vscode
**/.DS_Store
**/*.swp

# Local databases, backups, uploads and generated release/build artifacts.
**/*.db
**/*.db-*
**/*.sqlite
**/*.sqlite-*
**/*.sqlite3
**/*.sqlite3-*
**/*.dump
**/*.backup
**/*.bak
**/*.sql.gz
**/pgdata
**/postgres-data
**/backup
**/backups
**/uploads
**/upload
**/.tmp
**/tmp
**/logs
**/*.log
**/build
**/dist
**/*.tar
**/*.tar.gz
**/*.tgz
**/*.zip
**/*.apk
**/*.aab

# This tracked template contains placeholders and remains available as documentation.
!.env.example
