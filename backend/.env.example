# Скопируйте в .env и подставьте значения. Файл .env не коммитится.

DATABASE_URL=postgresql+psycopg://postgres:1798@localhost:5432/modish

# Секрет подписи JWT (в продакшене — длинная случайная строка)
JWT_SECRET=REPLACE_ME
# In-memory authentication rate limits apply per backend worker.
AUTH_LOGIN_PER_MINUTE=10
AUTH_REGISTER_PER_MINUTE=5

# Закрытая альфа: по умолчанию выключена. При true пустой/неверный список запрещает доступ.
# Укажите до 50 точных email через запятую; без wildcard и без реальных адресов в репозитории.
# Изменение deployment environment требует перезапуска процесса; .env не отслеживается автоматически.
CLOSED_ALPHA_ENABLED=false
CLOSED_ALPHA_ALLOWED_EMAILS=

# Optional paid style-image generation is disabled until a separate provider
# budget/quota policy is approved. Only true/1 explicitly enables the endpoint.
STYLE_VISUAL_ENABLED=false

# Опционально
JWT_EXPIRES_HOURS=24

# Редкий dev: POST /admin/catalog/demo-seed и demo-rewrite-image-urls (нужен ADMIN_TOKEN)
# По умолчанию эти ручки выключены; для включения:
# ALLOW_DEMO_CATALOG=1
# Optional ADMIN_TOKEN protects administrative requests; configure a random deployment value.

# Alpha Befree: URL XML/YML фида (опционально; иначе задайте позже PATCH источника)
# BEFREE_FEED_URL=https://example.com/feed.xml

# Локально: если trial в БД истёк, а тестировать анализ нужно — временно ALLOW_DEV_ANALYZE=1
# ALLOW_DEV_ANALYZE=1

# === AI provider (OpenAI / DeepSeek / другие OpenAI-compatible) ===
# По умолчанию код рассчитан на OpenAI Responses API. Для временного DeepSeek обычно проще включить chat режим.
#
# Вариант 1 (OpenAI как сейчас):
# OPENAI_API_KEY=sk-...
# AI_MODE=responses
# AI_BASE_URL=https://api.openai.com
#
# Вариант 2 (DeepSeek временно, OpenAI-compatible Chat Completions):
 AI_API_KEY=REPLACE_ME
 AI_MODE=chat
 AI_BASE_URL=https://api.deepseek.com
#
# Если ваш провайдер использует другой путь — переопределите:
# AI_CHAT_COMPLETIONS_PATH=/v1/chat/completions
# AI_RESPONSES_PATH=/v1/responses
#
# Лента /products без source=demo не отдают source=demo (только реальные фиды).

# Production (P1)
# CORS_ORIGINS=https://app.yourdomain.com
# RATE_LIMIT_PER_MINUTE=120
# Optional ADMIN_CATALOG_TOKEN protects catalog administration; configure a random deployment value.

# Production validates required database and signing configuration.
APP_ENV=development

# Optional Admitad export; obtain NEW credentials after revocation.
ADMITAD_ENABLED=false
ADMITAD_WEBSITE_ID=REPLACE_ME
ADMITAD_EXPORT_USER=REPLACE_ME
ADMITAD_EXPORT_CODE=REPLACE_ME
