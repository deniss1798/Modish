# Скопируйте в .env и подставьте значения. Файл .env не коммитится.

DATABASE_URL=postgresql+psycopg://postgres:1798@localhost:5432/modish

# Секрет подписи JWT (в продакшене — длинная случайная строка)
JWT_SECRET=change-me-to-a-long-random-string

# Опционально
JWT_EXPIRES_HOURS=24

# Редкий dev: POST /admin/catalog/demo-seed и demo-rewrite-image-urls (нужен ADMIN_TOKEN)
# По умолчанию эти ручки выключены; для включения:
# ALLOW_DEMO_CATALOG=1
# ADMIN_TOKEN=сгенерируй-случайную-строку

# Alpha Befree: URL XML/YML фида (опционально; иначе задайте позже PATCH источника)
# BEFREE_FEED_URL=https://example.com/feed.xml

# Локально: если trial в БД истёк, а тестировать анализ нужно — временно ALLOW_DEV_ANALYZE=1
# ALLOW_DEV_ANALYZE=1

# === AI provider (OpenAI / DeepSeek / другие OpenAI-compatible) ===
# По умолчанию код рассчитан на OpenAI Responses API. Для временного DeepSeek обычно проще включить chat режим.
#
# Вариант 1 (OpenAI как сейчас):
# OPENAI_API_KEY=sk-...
# AI_MODE=responses
# AI_BASE_URL=https://api.openai.com
#
# Вариант 2 (DeepSeek временно, OpenAI-compatible Chat Completions):
 AI_API_KEY=sk-d2f6fb5188b84078a563df5a89585f62
 AI_MODE=chat
 AI_BASE_URL=https://api.deepseek.com
#
# Если ваш провайдер использует другой путь — переопределите:
# AI_CHAT_COMPLETIONS_PATH=/v1/chat/completions
# AI_RESPONSES_PATH=/v1/responses
#
# Лента /products без source=demo не отдают source=demo (только реальные фиды).
